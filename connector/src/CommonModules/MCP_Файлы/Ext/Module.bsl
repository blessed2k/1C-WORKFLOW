// Чтение присоединённых файлов БСП для метода /file HTTP-сервиса MCP_Сервис.
//
// Вынесено в отдельный общий модуль, потому что зовёт БСП (РаботаСФайлами, ОбщегоНазначения):
// в базе без БСП не скомпилируется только этот модуль и откажет только /file, остальные методы
// коннектора продолжат работать. Строго read-only: права, реквизиты и двоичные данные файла.

#Область СлужебныйПрограммныйИнтерфейс

// Читает присоединённый файл БСП правами текущего пользователя.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка, разобранная из параметров запроса.
//  МаксимумРазмера - Число - предел размера файла в байтах; файл больше не читается.
//
// Возвращаемое значение:
//  Структура:
//   * ДвоичныеДанные - ДвоичныеДанные - содержимое файла;
//                    - Неопределено - файл не прочитан, причина в остальных полях.
//   * ИмяФайла - Строка - имя с расширением без недопустимых в имени файла символов.
//   * Расширение - Строка - расширение в нижнем регистре, без точки.
//   * Статус - Число - код HTTP ошибки, когда файл не прочитан.
//   * КодОшибки - Строка - код ошибки конверта коннектора.
//   * ТекстОшибки - Строка
//
Функция ПрочитатьФайл(Ссылка, МаксимумРазмера) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("Расширение", "");
	Результат.Вставить("Статус", 0);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ТекстОшибки", "");
	МетаданныеСсылки = Ссылка.Метаданные();

	// Двоичные данные есть только у присоединённого файла БСП (справочники ...ПрисоединенныеФайлы,
	// Файлы, ВерсииФайлов). Ссылку на документ или контрагента дальше не пускаем.
	Если Не Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Возврат ОшибкаЧтения(Результат, 400, "not_a_file",
			"Тип " + МетаданныеСсылки.ПолноеИмя() + " не справочник присоединённых файлов");
	КонецЕсли;
	Идентификатор = Строка(Ссылка.УникальныйИдентификатор());

	// Хранилище файла БСП читает в привилегированном режиме, поэтому право пользователя на таблицу
	// и на саму запись проверяется здесь, до чтения данных.
	Если Не ПравоДоступа("Чтение", МетаданныеСсылки) Тогда
		Возврат ОшибкаЧтения(Результат, 403, "forbidden", "Нет права на чтение " + МетаданныеСсылки.ПолноеИмя());
	КонецЕсли;
	ИменаРеквизитов = "Наименование, Расширение, Размер";
	Если МетаданныеСсылки.Иерархический Тогда
		ИменаРеквизитов = ИменаРеквизитов + ", ЭтоГруппа";
	КонецЕсли;
	ЕстьВладелец = ОбщегоНазначения.ЕстьРеквизитОбъекта("ВладелецФайла", МетаданныеСсылки);
	Если ЕстьВладелец Тогда
		ИменаРеквизитов = ИменаРеквизитов + ", ВладелецФайла";
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ИменаРеквизитов, Истина);
	Если Реквизиты.Наименование = Неопределено Тогда
		Возврат ОшибкаЧтения(Результат, 404, "not_found", "Файл не найден или нет доступа к записи: " + Идентификатор);
	КонецЕсли;
	Если Реквизиты.Свойство("ЭтоГруппа") И Реквизиты.ЭтоГруппа Тогда
		Возврат ОшибкаЧтения(Результат, 400, "not_a_file", "Это папка файлов, а не файл: " + Идентификатор);
	КонецЕсли;
	// Справочник файлов часто читается без ограничения по записям, а документ-владелец с ним:
	// файл отдаётся только тому, кто видит и сам документ. Иначе по ссылке на файл читался бы
	// скан счёта, который пользователю не виден. Ответ тот же, что у ненайденного файла.
	Если ЕстьВладелец И Не ВладелецДоступен(Реквизиты.ВладелецФайла) Тогда
		Возврат ОшибкаЧтения(Результат, 404, "not_found", "Файл не найден или нет доступа к записи: " + Идентификатор);
	КонецЕсли;

	Если Реквизиты.Размер > МаксимумРазмера Тогда
		ТекстОшибки = СтрШаблон("Файл %1 байт, больше предела %2 байт",
			Формат(Реквизиты.Размер, "ЧГ=0"), Формат(МаксимумРазмера, "ЧГ=0"));
		Возврат ОшибкаЧтения(Результат, 413, "file_too_large", ТекстОшибки);
	КонецЕсли;

	ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(Ссылка, Ложь);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат ОшибкаЧтения(Результат, 404, "file_data_not_found",
			"Данные файла не найдены ни в базе, ни в томах: " + Идентификатор);
	КонецЕсли;

	Результат.Расширение = НРег(Реквизиты.Расширение);
	ИмяФайла = ОбщегоНазначенияКлиентСервер.ПолучитьИмяСРасширением(Реквизиты.Наименование, Результат.Расширение);
	Результат.ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайла);
	Результат.ДвоичныеДанные = ДвоичныеДанные;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВладелецДоступен(Владелец)
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ПравоДоступа("Чтение", Владелец.Метаданные()) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "Ссылка", Истина) <> Неопределено;
КонецФункции

Функция ОшибкаЧтения(Результат, Статус, КодОшибки, ТекстОшибки)
	Результат.Статус = Статус;
	Результат.КодОшибки = КодОшибки;
	Результат.ТекстОшибки = ТекстОшибки;
	Возврат Результат;
КонецФункции

#КонецОбласти
