// Чтение журнала регистрации для HTTP-сервиса MCP_Сервис.
//
// Вынесено в общий модуль по той же причине, что и запросы: чтение с ограничением времени идёт
// в фоновом задании, а оно вызывает только экспортные методы общих модулей. Разбор тела запроса
// лежит здесь же, потому что отбор по метаданным содержит объекты метаданных, а их в фоновое
// задание не передать: туда уходит само тело запроса.

#Область СлужебныйПрограммныйИнтерфейс

// Читает журнал регистрации по отбору из тела запроса /eventlog.
//
// Параметры:
//  Тело - Структура - разобранный JSON тела запроса.
//
// Возвращаемое значение:
//  Структура - при успехе ключи events, total, truncated, applied, как их читает Go-клиент
//    (HTTPSource.EventLog); при ошибке один ключ Ошибка со структурой Текст, Статус, Код.
//
Функция РезультатЖурнала(Тело) Экспорт

	Отбор = Новый Структура;
	Примененные = Новый Массив;
	ТекстОшибки = "";
	Если Не ЗаполнитьОтбор(Отбор, Примененные, Тело, ТекстОшибки) Тогда
		Возврат ОтказЧтения(ТекстОшибки, "bad_request");
	КонецЕсли;

	Порядок = НРег(СтрокаИзТела(Тело, "order"));
	Если Порядок <> "" И Порядок <> "asc" И Порядок <> "desc" Тогда
		Возврат ОтказЧтения("Неизвестный порядок: " + Порядок + ". Допустимы asc и desc", "bad_request");
	КонецЕсли;
	Лимит = ЧислоИзТела(Тело, "limit", 100, 1, МаксимумЗаписей());
	Смещение = ЧислоИзТела(Тело, "offset", 0, 0, МаксимумОкна());
	ПределКомментария = ЧислоИзТела(Тело, "max_comment", 4000, 0, 1000000);
	Если Порядок <> "" Тогда
		Примененные.Добавить("order");
	КонецЕсли;
	Если Смещение > 0 Тогда
		Примененные.Добавить("offset");
	КонецЕсли;

	// Платформа умеет отдать только последние N записей под отбор, в хронологическом порядке.
	// Поэтому «первые записи окна» читаются чтением окна целиком, и окно обязано быть небольшим.
	Таблица = Новый ТаблицаЗначений;
	Если Порядок = "asc" Тогда
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, КолонкиЖурнала(), , МаксимумОкна() + 1);
		Количество = Таблица.Количество();
		Если Количество > МаксимумОкна() Тогда
			Возврат ОтказЧтения(СтрШаблон(
				"Под отбор попадает больше %1 записей журнала, первые записи такого окна не прочитать. "
				+ "Сузьте окно по дате или добавьте отбор.", Формат(МаксимумОкна(), "ЧГ=")), "window_too_large");
		КонецЕсли;
		Первый = Смещение;
		Последний = Мин(Смещение + Лимит, Количество) - 1;
		Обрезано = Количество > Смещение + Лимит;
	Иначе
		// Читаем на запись больше нужного: лишняя строка отвечает на вопрос, была ли обрезка.
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, КолонкиЖурнала(), , Смещение + Лимит + 1);
		Количество = Таблица.Количество();
		Последний = Количество - 1 - Смещение;
		Первый = Макс(Последний - Лимит + 1, 0);
		Обрезано = Количество > Смещение + Лимит;
	КонецЕсли;

	События = Новый Массив;
	Если Порядок = "desc" Тогда
		Индекс = Последний;
		Пока Индекс >= Первый Цикл
			События.Добавить(СобытиеВСтруктуру(Таблица[Индекс], ПределКомментария));
			Индекс = Индекс - 1;
		КонецЦикла;
	Иначе
		Для Индекс = Первый По Последний Цикл
			События.Добавить(СобытиеВСтруктуру(Таблица[Индекс], ПределКомментария));
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("events", События);
	Результат.Вставить("total", События.Количество());
	Результат.Вставить("truncated", Обрезано);
	// Клиент сверяет этот список со своим: коннектор прежней версии молча отбросил бы отбор,
	// которого не знает, и вернул выборку шире запрошенной.
	Результат.Вставить("applied", Примененные);
	Возврат Результат;

КонецФункции

// Точка входа фонового задания: то же, что РезультатЖурнала, но ответ кладётся во временное
// хранилище, адрес которого завёл вызвавший сеанс HTTP-сервиса.
//
// Параметры:
//  Тело - Структура - разобранный JSON тела запроса.
//  АдресРезультата - Строка - адрес во временном хранилище.
//
Процедура ПрочитатьВФоне(Тело, АдресРезультата) Экспорт

	ПоместитьВоВременноеХранилище(РезультатЖурнала(Тело), АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаполнитьОтбор(Отбор, Примененные, Тело, ТекстОшибки)

	Если Не ДобавитьДату(Отбор, "ДатаНачала", СтрокаИзТела(Тело, "start_date")) Тогда
		ТекстОшибки = "Некорректная дата в start_date";
		Возврат Ложь;
	КонецЕсли;
	Если Не ДобавитьДату(Отбор, "ДатаОкончания", СтрокаИзТела(Тело, "end_date")) Тогда
		ТекстОшибки = "Некорректная дата в end_date";
		Возврат Ложь;
	КонецЕсли;

	// Нераспознанное значение отбора даёт ошибку, а не пропуск: молча снятый отбор хуже ошибки,
	// клиент получил бы выборку шире запрошенной и принял её за отфильтрованную.
	ИмяУровня = СтрокаИзТела(Тело, "level");
	Если Не ПустаяСтрока(ИмяУровня) Тогда
		Уровень = УровеньЖурнала(ИмяУровня);
		Если Уровень = Неопределено Тогда
			ТекстОшибки = "Неизвестный уровень журнала: " + ИмяУровня;
			Возврат Ложь;
		КонецЕсли;
		Отбор.Вставить("Уровень", Уровень);
		Примененные.Добавить("level");
	КонецЕсли;

	ИмяСтатуса = СтрокаИзТела(Тело, "transaction_status");
	Если Не ПустаяСтрока(ИмяСтатуса) Тогда
		Статус = СтатусТранзакции(ИмяСтатуса);
		Если Статус = Неопределено Тогда
			ТекстОшибки = "Неизвестный статус транзакции: " + ИмяСтатуса;
			Возврат Ложь;
		КонецЕсли;
		Отбор.Вставить("СтатусТранзакции", Статус);
		Примененные.Добавить("transaction_status");
	КонецЕсли;

	// Пользователь задаётся именем: так отбор работает и по удалённым пользователям.
	ДобавитьСтроку(Отбор, Примененные, Тело, "user", "Пользователь");
	ДобавитьСтроку(Отбор, Примененные, Тело, "computer", "Компьютер");
	ДобавитьСтроку(Отбор, Примененные, Тело, "data_presentation", "ПредставлениеДанных");
	ДобавитьСтроку(Отбор, Примененные, Тело, "comment", "Комментарий");
	ДобавитьСтроку(Отбор, Примененные, Тело, "transaction", "Транзакция");
	ДобавитьСписок(Отбор, Примененные, Тело, "events", "Событие", Тип("Строка"));
	ДобавитьСписок(Отбор, Примененные, Тело, "applications", "ИмяПриложения", Тип("Строка"));
	ДобавитьСписок(Отбор, Примененные, Тело, "sessions", "Сеанс", Тип("Число"));

	Возврат ДобавитьОтборМетаданных(Отбор, Примененные, Тело, ТекстОшибки)
		И ДобавитьОтборДанных(Отбор, Примененные, Тело, ТекстОшибки);

КонецФункции

Функция ДобавитьОтборМетаданных(Отбор, Примененные, Тело, ТекстОшибки)

	ИменаМетаданных = СписокИзТела(Тело, "metadata", Тип("Строка"));
	Если ИменаМетаданных.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	ОбъектыМетаданных = Новый Массив;
	Для Каждого ПолноеИмя Из ИменаМетаданных Цикл
		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОбъектМД = Неопределено Тогда
			ТекстОшибки = "Объект метаданных не найден: " + ПолноеИмя;
			Возврат Ложь;
		КонецЕсли;
		ОбъектыМетаданных.Добавить(ОбъектМД);
	КонецЦикла;
	Отбор.Вставить("Метаданные", ОбъектыМетаданных);
	Примененные.Добавить("metadata");
	Возврат Истина;

КонецФункции

Функция ДобавитьОтборДанных(Отбор, Примененные, Тело, ТекстОшибки)

	// Ссылка задаётся так же, как параметр запроса: объектом {type, ref}.
	ОписаниеДанных = Неопределено;
	Если Не Тело.Свойство("data", ОписаниеДанных) Или ОписаниеДанных = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Значения = MCP_Запросы.ПараметрыЗапроса(Новый Структура("data", ОписаниеДанных), ТекстОшибки);
	Если Значения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Отбор.Вставить("Данные", Значения.Получить("data"));
	Примененные.Добавить("data");
	Возврат Истина;

КонецФункции

Функция СобытиеВСтруктуру(Строка, ПределКомментария)

	Событие = Новый Структура;
	Событие.Вставить("date", XMLСтрока(Строка.Дата));
	Событие.Вставить("level", Строка(Строка.Уровень));
	Событие.Вставить("event", Строка.ПредставлениеСобытия);
	Событие.Вставить("event_id", Строка.Событие);
	Событие.Вставить("user", Строка.ИмяПользователя);
	Событие.Вставить("computer", Строка.Компьютер);
	Событие.Вставить("application", Строка.ПредставлениеПриложения);
	Событие.Вставить("application_id", Строка.ИмяПриложения);
	Событие.Вставить("session", Строка.Сеанс);
	Событие.Вставить("connection", Строка.Соединение);
	Событие.Вставить("metadata", ВСтроку(Строка.ПредставлениеМетаданных));
	Событие.Вставить("metadata_id", ВСтроку(Строка.Метаданные));
	Событие.Вставить("data", MCP_Запросы.ЗначениеДляJSON(Строка.Данные, Истина));
	Событие.Вставить("data_presentation", Строка.ПредставлениеДанных);
	Событие.Вставить("comment", ОбрезанныйТекст(Строка.Комментарий, ПределКомментария));
	Событие.Вставить("transaction_status", Строка(Строка.СтатусТранзакции));
	Событие.Вставить("transaction", Строка.Транзакция);
	Возврат Событие;

КонецФункции

Функция КолонкиЖурнала()
	Возврат "Дата,Уровень,Событие,ПредставлениеСобытия,ИмяПользователя,Компьютер,ИмяПриложения,"
		+ "ПредставлениеПриложения,Сеанс,Соединение,Метаданные,ПредставлениеМетаданных,Данные,"
		+ "ПредставлениеДанных,Комментарий,СтатусТранзакции,Транзакция";
КонецФункции

Функция ОбрезанныйТекст(Текст, Предел)

	// Комментарий ошибки со стеком бывает на десятки тысяч символов, а записей в ответе сотни.
	Если Предел = 0 Или СтрДлина(Текст) <= Предел Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Предел) + СтрШаблон(" … [обрезано, всего символов: %1]", Формат(СтрДлина(Текст), "ЧГ="));

КонецФункции

Функция ВСтроку(Значение)

	// У событий доступа в колонках метаданных лежит массив имён, у остальных строка.
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Строка(Элемент));
		КонецЦикла;
		Возврат СтрСоединить(Части, ", ");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ОтказЧтения(Текст, Код)
	Возврат Новый Структура("Ошибка", Новый Структура("Текст, Статус, Код", Текст, 400, Код));
КонецФункции

Функция МаксимумЗаписей()
	Возврат 500;
КонецФункции

Функция МаксимумОкна()
	// Сколько записей под отбор коннектор согласен прочитать ради чтения с начала окна и смещения.
	Возврат 5000;
КонецФункции

Функция СтрокаИзТела(Тело, Ключ)

	Значение = Неопределено;
	Если Не Тело.Свойство(Ключ, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ЧислоИзТела(Тело, Ключ, ПоУмолчанию, Минимум, Максимум)

	Значение = Неопределено;
	Если Не Тело.Свойство(Ключ, Значение) Или ТипЗнч(Значение) <> Тип("Число") Или Значение < Минимум Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Мин(Цел(Значение), Максимум);

КонецФункции

Функция СписокИзТела(Тело, Ключ, ТипЭлемента)

	// Значение отбора задаётся одним значением или массивом; элементы чужого типа отбрасываются.
	Результат = Новый Массив;
	Значение = Неопределено;
	Если Не Тело.Свойство(Ключ, Значение) Или Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Одиночное = Значение;
		Значение = Новый Массив;
		Значение.Добавить(Одиночное);
	КонецЕсли;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) = ТипЭлемента И ЗначениеЗаполнено(Элемент) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьСтроку(Отбор, Примененные, Тело, Ключ, ИмяОтбора)

	Значение = СтрокаИзТела(Тело, Ключ);
	Если Не ПустаяСтрока(Значение) Тогда
		Отбор.Вставить(ИмяОтбора, Значение);
		Примененные.Добавить(Ключ);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСписок(Отбор, Примененные, Тело, Ключ, ИмяОтбора, ТипЭлемента)

	Значения = СписокИзТела(Тело, Ключ, ТипЭлемента);
	Если Значения.Количество() > 0 Тогда
		Отбор.Вставить(ИмяОтбора, Значения);
		Примененные.Добавить(Ключ);
	КонецЕсли;

КонецПроцедуры

Функция ДобавитьДату(Отбор, ИмяОтбора, Значение)

	// Истина, если дата разобрана или не задана. Ложь означает мусор в параметре.
	Если ПустаяСтрока(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	// Другого способа проверить строку даты, кроме самого разбора, нет.
	Попытка
		Отбор.Вставить(ИмяОтбора, XMLЗначение(Тип("Дата"), Значение));
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

Функция УровеньЖурнала(Значение)

	// Go-клиент переводит уровень в русское название перед отправкой, но руками зовут и английскими.
	Ключ = ВРег(СокрЛП(Значение));
	Если Ключ = "ERROR" Или Ключ = "ОШИБКА" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Ключ = "WARNING" Или Ключ = "ПРЕДУПРЕЖДЕНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли Ключ = "INFORMATION" Или Ключ = "ИНФОРМАЦИЯ" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Ключ = "NOTE" Или Ключ = "ПРИМЕЧАНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция СтатусТранзакции(Значение)

	Ключ = ВРег(СокрЛП(Значение));
	Если Ключ = "COMMITTED" Или Ключ = "ЗАФИКСИРОВАНА" Тогда
		Возврат СтатусТранзакцииЗаписиЖурналаРегистрации.Зафиксирована;
	ИначеЕсли Ключ = "ROLLEDBACK" Или Ключ = "ОТМЕНЕНА" Тогда
		Возврат СтатусТранзакцииЗаписиЖурналаРегистрации.Отменена;
	ИначеЕсли Ключ = "UNFINISHED" Или Ключ = "НЕЗАВЕРШЕНА" Тогда
		Возврат СтатусТранзакцииЗаписиЖурналаРегистрации.НеЗавершена;
	ИначеЕсли Ключ = "NOTAPPLICABLE" Или Ключ = "НЕТТРАНЗАКЦИИ" Тогда
		Возврат СтатусТранзакцииЗаписиЖурналаРегистрации.НетТранзакции;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

#КонецОбласти
