// Выполнение запросов для HTTP-сервиса MCP_Сервис.
//
// Вынесено в общий модуль, потому что запрос с ограничением времени выполняется в фоновом
// задании (иначе прервать его в базе нечем), а фоновое задание вызывает только экспортные методы
// общих модулей. Строго read-only: только Запрос.Выполнить() над текстом, который сервис уже
// проверил на ВЫБРАТЬ.

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет запрос и готовит тело ответа /query.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса, проверенный сервисом на ВЫБРАТЬ.
//  Параметры - Соответствие из КлючИЗначение - имя параметра и значение, см. ПараметрыЗапроса.
//  Лимит - Число - сколько строк вернуть.
//  СсылкиОбъектами - Булево - Истина: ссылка уходит объектом с идентификатором, а не строкой.
//
// Возвращаемое значение:
//  Структура - ключи columns, rows, total, truncated, как их читает Go-клиент (HTTPSource.ExecuteQuery).
//
Функция РезультатЗапроса(ТекстЗапроса, Параметры, Лимит, СсылкиОбъектами) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	Для Каждого Параметр Из Параметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Возврат РезультатВСтруктуру(Запрос.Выполнить(), Лимит, СсылкиОбъектами);

КонецФункции

// Точка входа фонового задания: то же, что РезультатЗапроса, но ответ кладётся во временное
// хранилище, адрес которого завёл вызвавший сеанс HTTP-сервиса.
//
// Параметры:
//  ТекстЗапроса - Строка
//  Параметры - Соответствие из КлючИЗначение
//  Лимит - Число
//  СсылкиОбъектами - Булево
//  АдресРезультата - Строка - адрес во временном хранилище.
//
Процедура ВыполнитьВФоне(ТекстЗапроса, Параметры, Лимит, СсылкиОбъектами, АдресРезультата) Экспорт

	Результат = РезультатЗапроса(ТекстЗапроса, Параметры, Лимит, СсылкиОбъектами);
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

// Приводит параметры запроса из JSON к значениям 1С. JSON не знает ни дат, ни ссылок, поэтому:
// строка вида 2026-09-01 или 2026-09-01T00:00:00 становится датой, объект {type, ref} ссылкой,
// объект {type, value} значением перечисления, массив обрабатывается поэлементно.
//
// Параметры:
//  ПараметрыТела - Структура, Соответствие, Неопределено - свойство parameters тела запроса.
//  ТекстОшибки - Строка - заполняется, когда значение привести не удалось.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - имя и значение параметра.
//  Неопределено - параметр не разобран, причина в ТекстОшибки.
//
Функция ПараметрыЗапроса(ПараметрыТела, ТекстОшибки) Экспорт

	Результат = Новый Соответствие;
	ТипПараметров = ТипЗнч(ПараметрыТела);
	Если ТипПараметров <> Тип("Структура") И ТипПараметров <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Параметр Из ПараметрыТела Цикл
		Значение = Неопределено;
		Если Не ПривестиЗначение(Параметр.Значение, Значение, ТекстОшибки) Тогда
			ТекстОшибки = СтрШаблон("Параметр %1: %2", Параметр.Ключ, ТекстОшибки);
			Возврат Неопределено;
		КонецЕсли;
		Результат.Вставить(Параметр.Ключ, Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение в виде, пригодном для записи в JSON: числа, строки и булево как есть, дата строкой
// ISO, остальное представлением.
//
// Параметры:
//  Значение - Произвольный
//  СсылкиОбъектами - Булево - Истина: ссылка уходит структурой presentation, type, ref,
//    значение перечисления структурой presentation, type, value.
//
// Возвращаемое значение:
//  Число, Строка, Булево, Структура, Неопределено
//
Функция ЗначениеДляJSON(Значение, СсылкиОбъектами) Экспорт

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Если СсылкиОбъектами Тогда
		Описание = ОписаниеСсылки(Значение, ТипЗначения);
		Если Описание <> Неопределено Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РезультатВСтруктуру(РезультатЗапроса, Лимит, СсылкиОбъектами)

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	// Go-клиент ждёт позиционные строки: массив массивов значений в порядке колонок.
	Строки = Новый Массив;
	Обрезано = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() >= Лимит Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Значения.Добавить(ЗначениеДляJSON(Выборка[Колонка.Имя], СсылкиОбъектами));
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("total", Строки.Количество());
	Результат.Вставить("truncated", Обрезано);
	Возврат Результат;

КонецФункции

Функция ОписаниеСсылки(Значение, ТипЗначения)

	// Ссылка в виде, который можно вернуть параметром следующего запроса. По представлению ссылку
	// не восстановить, поэтому без идентификатора клиенту остаётся искать объект по номеру или
	// наименованию, а это отбор без индекса.
	ОбъектМД = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолноеИмя = ОбъектМД.ПолноеИмя();
	Класс = КлассОбъекта(ПолноеИмя);

	Если Класс = "Перечисление" Тогда
		Описание = Новый Структура("presentation, type, value", Строка(Значение), ПолноеИмя, "");
		Если ЗначениеЗаполнено(Значение) Тогда
			Индекс = Перечисления[ОбъектМД.Имя].Индекс(Значение);
			Описание.value = ОбъектМД.ЗначенияПеречисления[Индекс].Имя;
		КонецЕсли;
		Возврат Описание;
	КонецЕсли;

	Если МенеджерСсылок(Класс, ОбъектМД.Имя) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("presentation, type, ref",
		Строка(Значение), ПолноеИмя, Строка(Значение.УникальныйИдентификатор()));

КонецФункции

Функция ПривестиЗначение(Исходное, Значение, ТекстОшибки)

	ТипИсходного = ТипЗнч(Исходное);
	Если ТипИсходного = Тип("Строка") Тогда
		Если Не ПохожеНаДату(Исходное) Тогда
			Значение = Исходное;
			Возврат Истина;
		КонецЕсли;
		// Строка уже проверена по форме, исключение здесь означает дату вида 2026-13-45.
		Попытка
			Значение = XMLЗначение(Тип("Дата"), ?(СтрДлина(Исходное) = ДлинаДатыБезВремени(),
				Исходное + "T00:00:00", Исходное));
		Исключение
			ТекстОшибки = "некорректная дата " + Исходное;
			Возврат Ложь;
		КонецПопытки;
		Возврат Истина;
	КонецЕсли;

	Если ТипИсходного = Тип("Массив") Тогда
		Значение = Новый Массив;
		Для Каждого Элемент Из Исходное Цикл
			ЗначениеЭлемента = Неопределено;
			Если Не ПривестиЗначение(Элемент, ЗначениеЭлемента, ТекстОшибки) Тогда
				Возврат Ложь;
			КонецЕсли;
			Значение.Добавить(ЗначениеЭлемента);
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;

	Если ТипИсходного = Тип("Структура") Тогда
		Возврат СсылкаИзОписания(Исходное, Значение, ТекстОшибки);
	КонецЕсли;

	Значение = Исходное;
	Возврат Истина;

КонецФункции

Функция СсылкаИзОписания(Описание, Значение, ТекстОшибки)

	ИмяТипа = "";
	Если Не Описание.Свойство("type", ИмяТипа) Или ТипЗнч(ИмяТипа) <> Тип("Строка") Или ПустаяСтрока(ИмяТипа) Тогда
		ТекстОшибки = "у объекта нет свойства type; ссылка задаётся как {type, ref}, значение перечисления как {type, value}";
		Возврат Ложь;
	КонецЕсли;
	ОбъектМД = Метаданные.НайтиПоПолномуИмени(ИмяТипа);
	Если ОбъектМД = Неопределено Тогда
		ТекстОшибки = "неизвестный тип " + ИмяТипа;
		Возврат Ложь;
	КонецЕсли;
	Класс = КлассОбъекта(ОбъектМД.ПолноеИмя());

	Если Класс = "Перечисление" Тогда
		ИмяЗначения = "";
		Описание.Свойство("value", ИмяЗначения);
		Если ТипЗнч(ИмяЗначения) <> Тип("Строка") Или ОбъектМД.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
			ТекстОшибки = СтрШаблон("у перечисления %1 нет значения %2", ИмяТипа, ИмяЗначения);
			Возврат Ложь;
		КонецЕсли;
		Значение = Перечисления[ОбъектМД.Имя][ИмяЗначения];
		Возврат Истина;
	КонецЕсли;

	Менеджер = МенеджерСсылок(Класс, ОбъектМД.Имя);
	Если Менеджер = Неопределено Тогда
		ТекстОшибки = СтрШаблон("тип %1 не ссылочный", ИмяТипа);
		Возврат Ложь;
	КонецЕсли;
	Идентификатор = "";
	Описание.Свойство("ref", Идентификатор);
	// Конструктор идентификатора проверяет форму строки сам, другого способа проверить её нет.
	Попытка
		Значение = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Исключение
		ТекстОшибки = СтрШаблон("некорректный идентификатор ссылки %1", Идентификатор);
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

Функция КлассОбъекта(ПолноеИмя)
	Возврат Лев(ПолноеИмя, СтрНайти(ПолноеИмя, ".") - 1);
КонецФункции

Функция МенеджерСсылок(Класс, Имя)

	// Неопределено: у вида нет ссылок, которые создаются по идентификатору (регистры,
	// перечисления, отчёты и прочее).
	Если Класс = "Справочник" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Класс = "Документ" Тогда
		Возврат Документы[Имя];
	ИначеЕсли Класс = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Класс = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Класс = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Класс = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Имя];
	ИначеЕсли Класс = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Имя];
	ИначеЕсли Класс = "Задача" Тогда
		Возврат Задачи[Имя];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ДлинаДатыБезВремени()
	Возврат СтрДлина("0000-00-00");
КонецФункции

Функция ПохожеНаДату(Строка)

	// Истина для строк строго вида 0000-00-00 и 0000-00-00T00:00:00. Строка другой формы остаётся
	// строкой: угадывать дату шире нельзя, параметр может быть обычным текстом.
	Образец = "0000-00-00T00:00:00";
	Длина = СтрДлина(Строка);
	Если Длина <> СтрДлина(Образец) И Длина <> ДлинаДатыБезВремени() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По Длина Цикл
		Символ = Сред(Строка, Позиция, 1);
		Ожидается = Сред(Образец, Позиция, 1);
		Если Ожидается = "0" Тогда
			Подходит = СтрНайти("0123456789", Символ) > 0;
		Иначе
			Подходит = (Символ = Ожидается);
		КонецЕсли;
		Если Не Подходит Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
