Функция ЕстьКоллекция(ВидОбъекта, ИмяКоллекции)
	// У объектов метаданных нет метода Свойство(): состав коллекций определяется видом объекта.
	СПредопределенными = "Справочник,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета";
	СРеквизитами = "Справочник,Документ,РегистрСведений,РегистрНакопления,РегистрБухгалтерии,"
		+ "РегистрРасчета,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,ПланОбмена,"
		+ "БизнесПроцесс,Задача,Отчет,Обработка";
	СТабличнымиЧастями = "Справочник,Документ,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,"
		+ "ПланОбмена,БизнесПроцесс,Задача,Отчет,Обработка";
	СФормами = СРеквизитами + ",Перечисление,ЖурналДокументов";

	Владельцы = Новый Соответствие;
	Владельцы.Вставить("Реквизиты", СРеквизитами);
	Владельцы.Вставить("ТабличныеЧасти", СТабличнымиЧастями);
	Владельцы.Вставить("Измерения", "РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета");
	Владельцы.Вставить("Ресурсы", "РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета");
	Владельцы.Вставить("ЗначенияПеречисления", "Перечисление");
	Владельцы.Вставить("ПредопределенныеДанные", СПредопределенными);
	Владельцы.Вставить("Формы", СФормами);
	Владельцы.Вставить("Команды", СФормами);

	Виды = Владельцы.Получить(ИмяКоллекции);
	Если Виды = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрРазделить(Виды, ",", Ложь).Найти(ВидОбъекта) <> Неопределено;
КонецФункции

