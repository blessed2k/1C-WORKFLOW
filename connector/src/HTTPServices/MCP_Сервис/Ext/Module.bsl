Функция ЗначениеТела(Тело, Ключ)
	Значение = Неопределено;
	Если Не Тело.Свойство(Ключ, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
