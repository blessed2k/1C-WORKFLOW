Функция ОбъектGET(Запрос) Экспорт

	// Go-клиент ходит на /object/{type}/{name}, ручные вызовы удобнее делать через
	// ?type=&name=: принимаем оба варианта.
	Тип = ПараметрЗапроса(Запрос, "type");
	Имя = ПараметрЗапроса(Запрос, "name");
	Если ПустаяСтрока(Тип) Или ПустаяСтрока(Имя) Тогда
		Возврат ОтветОшибки("Требуются параметры type и name", 400);
	КонецЕсли;

	РусскийТип = АнглийскийТипВРусский(Тип);
	Если РусскийТип = "" Тогда
		Возврат ОтветОшибки("Неизвестный тип объекта: " + Тип, 400);
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(РусскийТип + "." + Имя);
	Если ОбъектМД = Неопределено Тогда
		Возврат ОтветОшибки("Объект не найден: " + Тип + "." + Имя, 404);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("type", Тип);
	Результат.Вставить("name", ОбъектМД.Имя);
	Результат.Вставить("synonym", ПредставлениеСинонима(ОбъектМД));
	Результат.Вставить("attributes", РеквизитыВМассив(ОбъектМД, РусскийТип));
	// Имена ключей должны совпадать с тем, что читает Go-клиент (internal/source/httpsource.go):
	// именно tabularParts, а не tabularSections.
	Результат.Вставить("tabularParts", ТабличныеЧастиВМассив(ОбъектМД, РусскийТип));
	Результат.Вставить("dimensions", ПоляКоллекции(ОбъектМД, РусскийТип, "Измерения"));
	Результат.Вставить("resources", ПоляКоллекции(ОбъектМД, РусскийТип, "Ресурсы"));
	Результат.Вставить("values", ЗначенияПеречисленияВМассив(ОбъектМД, РусскийТип));
	Результат.Вставить("forms", ИменаКоллекции(ОбъектМД, РусскийТип, "Формы"));
	Результат.Вставить("commands", ИменаКоллекции(ОбъектМД, РусскийТип, "Команды"));

	Возврат ОтветJSON(Результат);

КонецФункции

Функция ЗапросPOST(Запрос) Экспорт

	Тело = ТелоЗапросаJSON(Запрос);
	Если Тело = Неопределено Тогда
		Возврат ОтветОшибки("Некорректный JSON в теле запроса", 400);
	КонецЕсли;

	ТекстЗапроса = "";
	Тело.Свойство("query", ТекстЗапроса);
	Если Не ЭтоSelect(ТекстЗапроса) Тогда
		Возврат ОтветОшибки("Разрешены только запросы ВЫБРАТЬ (SELECT)", 403);
	КонецЕсли;

	Лимит = ЛимитИзТела(Тело, 100, МаксимумСтрокЗапроса());

	Запрос1С = Новый Запрос;
	Запрос1С.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос1С.Текст = ТекстЗапроса;
	УстановитьПараметрыЗапроса(Запрос1С, Тело);

	Попытка
		РезультатЗапроса = Запрос1С.Выполнить();
	Исключение
		Возврат ОтветОшибки("Ошибка выполнения запроса: " + ИнформацияОбОшибке().Описание, 400);
	КонецПопытки;

	Возврат ОтветJSON(РезультатЗапросаВСтруктуру(РезультатЗапроса, Лимит));

КонецФункции

Функция ВалидацияЗапросаPOST(Запрос) Экспорт

	Тело = ТелоЗапросаJSON(Запрос);
	Если Тело = Неопределено Тогда
		Возврат ОтветОшибки("Некорректный JSON в теле запроса", 400);
	КонецЕсли;

	ТекстЗапроса = "";
	Тело.Свойство("query", ТекстЗапроса);

	Ошибки = Новый Массив;
	Валиден = Ложь;
	Попытка
		Запрос1С = Новый Запрос(ТекстЗапроса);
		Запрос1С.НайтиПараметры();
		Валиден = Истина;
	Исключение
		Ошибки.Добавить(ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Возврат ОтветJSON(Новый Структура("valid, errors", Валиден, Ошибки));

КонецФункции

Функция ЖурналPOST(Запрос) Экспорт

	Тело = ТелоЗапросаJSON(Запрос);
	Если Тело = Неопределено Тогда
		Возврат ОтветОшибки("Некорректный JSON в теле запроса", 400);
	КонецЕсли;

	Отбор = Новый Структура;
	Если Не ДобавитьОтборДаты(Отбор, "ДатаНачала", ЗначениеТела(Тело, "start_date")) Тогда
		Возврат ОтветОшибки("Некорректная дата в start_date", 400);
	КонецЕсли;
	Если Не ДобавитьОтборДаты(Отбор, "ДатаОкончания", ЗначениеТела(Тело, "end_date")) Тогда
		Возврат ОтветОшибки("Некорректная дата в end_date", 400);
	КонецЕсли;

	ИмяУровня = ЗначениеТела(Тело, "level");
	Уровень = УровеньЖурнала(ИмяУровня);
	// Нераспознанный уровень раньше просто исчезал, и ответ содержал события всех уровней.
	Если Уровень = Неопределено И Не ПустаяСтрока(ИмяУровня) Тогда
		Возврат ОтветОшибки("Неизвестный уровень журнала: " + ИмяУровня, 400);
	КонецЕсли;
	Если Уровень <> Неопределено Тогда
		Отбор.Вставить("Уровень", Уровень);
	КонецЕсли;
	ИмяПользователя = ЗначениеТела(Тело, "user");
	Если Не ПустаяСтрока(ИмяПользователя) Тогда
		// Отбор журнала принимает идентификатор пользователя ИБ, а контракт оперирует именем.
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
		Если ПользовательИБ = Неопределено Тогда
			Возврат ОтветОшибки("Пользователь ИБ не найден: " + ИмяПользователя, 400);
		КонецЕсли;
		Отбор.Вставить("Пользователь", ПользовательИБ.УникальныйИдентификатор);
	КонецЕсли;

	Лимит = ЛимитИзТела(Тело, 100, МаксимумЗаписейЖурнала());

	// Читаем на запись больше лимита: лишняя строка отвечает на вопрос, была ли обрезка.
	// Количество передаётся в саму выгрузку, иначе многолетний журнал целиком уедет в память
	// рабочего процесса ради пяти строк ответа.
	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, Отбор, , , Лимит + 1);

	Обрезано = Таблица.Количество() > Лимит;
	События = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если События.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Событие = Новый Структура;
		Событие.Вставить("date", XMLСтрока(Строка.Дата));
		Событие.Вставить("level", Строка(Строка.Уровень));
		Событие.Вставить("user", Строка.ИмяПользователя);
		Событие.Вставить("event", Строка.ПредставлениеСобытия);
		Событие.Вставить("comment", Строка.Комментарий);
		Событие.Вставить("metadata", Строка.ПредставлениеМетаданных);
		События.Добавить(Событие);
	КонецЦикла;

	Возврат ОтветJSON(Новый Структура("events, total, truncated",
		События, События.Количество(), Обрезано));

КонецФункции

Функция ПодсистемаGET(Запрос) Экспорт

	Имя = ПараметрЗапроса(Запрос, "name");
	Если ПустаяСтрока(Имя) Тогда
		Возврат ОтветОшибки("Требуется имя подсистемы", 400);
	КонецЕсли;

	ОбъектМД = НайтиПодсистему(Метаданные.Подсистемы, Имя);
	Если ОбъектМД = Неопределено Тогда
		Возврат ОтветОшибки("Подсистема не найдена: " + Имя, 404);
	КонецЕсли;

	Дочерние = Новый Массив;
	Для Каждого Дочерняя Из ОбъектМД.Подсистемы Цикл
		Дочерние.Добавить(Дочерняя.Имя);
	КонецЦикла;

	Состав = Новый Массив;
	Для Каждого ЭлементСостава Из ОбъектМД.Состав Цикл
		Состав.Добавить(ЭлементСостава.ПолноеИмя());
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("name", ОбъектМД.Имя);
	Результат.Вставить("synonym", ПредставлениеСинонима(ОбъектМД));
	Результат.Вставить("subsystems", Дочерние);
	Результат.Вставить("content", Состав);

	Возврат ОтветJSON(Результат);

КонецФункции

Функция ПредопределенныеGET(Запрос) Экспорт

	Тип = ПараметрЗапроса(Запрос, "type");
	Имя = ПараметрЗапроса(Запрос, "name");
	Если ПустаяСтрока(Тип) Или ПустаяСтрока(Имя) Тогда
		Возврат ОтветОшибки("Требуются параметры type и name", 400);
	КонецЕсли;

	РусскийТип = АнглийскийТипВРусский(Тип);
	Если РусскийТип = "" Тогда
		Возврат ОтветОшибки("Неизвестный тип объекта: " + Тип, 400);
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(РусскийТип + "." + Имя);
	Если ОбъектМД = Неопределено Тогда
		Возврат ОтветОшибки("Объект не найден: " + Тип + "." + Имя, 404);
	КонецЕсли;

	Если Не ЕстьКоллекция(РусскийТип, "ПредопределенныеДанные") Тогда
		Возврат ОтветОшибки("У объекта нет предопределённых данных: " + Тип + "." + Имя, 400);
	КонецЕсли;

	// Список предопределённых читается запросом, а не из метаданных: коллекции
	// предопределённых у объекта метаданных в рантайме нет. Значит в ответ попадают
	// элементы, реально существующие в базе. Описанные в конфигурации, но не созданные,
	// сюда не войдут: это видно только в оффлайн-режиме по Ext/Predefined.xml.
	Лимит = МаксимумПредопределенных();
	Запрос1С = Новый Запрос;
	Запрос1С.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + "
		|	Таблица.Ссылка КАК Ссылка,
		|	Таблица.ИмяПредопределенныхДанных КАК Имя
		|ИЗ
		|	" + РусскийТип + "." + Имя + " КАК Таблица
		|ГДЕ
		|	Таблица.Предопределенный
		|УПОРЯДОЧИТЬ ПО
		|	Имя";

	Попытка
		Выборка = Запрос1С.Выполнить().Выбрать();
	Исключение
		Возврат ОтветОшибки("Ошибка чтения предопределённых: " + ИнформацияОбОшибке().Описание, 400);
	КонецПопытки;

	// Лишняя (Лимит + 1) строка означает, что список обрезан, и клиент это увидит.
	Элементы = Новый Массив;
	Обрезано = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() >= Лимит Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("name, ref", Выборка.Имя, Строка(Выборка.Ссылка)));
	КонецЦикла;

	Возврат ОтветJSON(Новый Структура("items, total, truncated",
		Элементы, Элементы.Количество(), Обрезано));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветJSON(Значение, Код = 200)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.УстановитьТелоИзСтроки(ВСтрокуJSON(Значение), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибки(Текст, Код)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ВСтрокуJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ТелоЗапросаJSON(Запрос)
	Попытка
		Строка = Запрос.ПолучитьТелоКакСтроку();
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Строка);
		Возврат ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ЭтоSelect(Текст)
	// Проверяем границу ключевого слова, иначе «ВЫБРАТЬЧТОУГОДНО» пройдёт как SELECT.
	Очищенный = ВРег(СокрЛП(УдалитьВедущиеКомментарии(Текст)));
	Возврат НачинаетсяСлово(Очищенный, "ВЫБРАТЬ") Или НачинаетсяСлово(Очищенный, "SELECT");
КонецФункции

Функция НачинаетсяСлово(Текст, Слово)
	Если Не СтрНачинаетсяС(Текст, Слово) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(Текст) = СтрДлина(Слово) Тогда
		Возврат Истина;
	КонецЕсли;
	Следующий = Сред(Текст, СтрДлина(Слово) + 1, 1);
	Возврат Следующий = " " Или Следующий = Символы.Таб Или Следующий = Символы.ПС
		Или Следующий = Символы.ВК;
КонецФункции

Функция УдалитьВедущиеКомментарии(Текст)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Результат = Новый Массив;
	Пропускаем = Истина;
	Для Каждого Строка Из Строки Цикл
		Если Пропускаем Тогда
			Обрезанная = СокрЛП(Строка);
			Если Обрезанная = "" Или СтрНачинаетсяС(Обрезанная, "//") Тогда
				Продолжить;
			КонецЕсли;
			Пропускаем = Ложь;
		КонецЕсли;
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос1С, Тело)
	// ПрочитатьJSON отдаёт объект как Структуру, а вложенные объекты в некоторых режимах
	// как Соответствие: принимаем оба, иначе параметры молча не доедут до запроса.
	Параметры = Неопределено;
	Если Не Тело.Свойство("parameters", Параметры) Или Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипПараметров = ТипЗнч(Параметры);
	Если ТипПараметров <> Тип("Соответствие") И ТипПараметров <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КЗ Из Параметры Цикл
		Запрос1С.УстановитьПараметр(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
КонецПроцедуры

Функция РезультатЗапросаВСтруктуру(РезультатЗапроса, Лимит)
	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	// Go-клиент ждёт позиционные строки: массив массивов значений в порядке колонок.
	Строки = Новый Массив;
	Обрезано = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() >= Лимит Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Значения.Добавить(ЗначениеДляJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Возврат Новый Структура("columns, rows, total, truncated", Колонки, Строки, Строки.Количество(), Обрезано);
КонецФункции

Функция ЗначениеДляJSON(Значение)
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Процедура ДобавитьКоллекциюМетаданных(Результат, ИмяКоллекции, Коллекция)
	Имена = Новый Массив;
	Для Каждого ОбъектМД Из Коллекция Цикл
		Имена.Добавить(ОбъектМД.Имя);
	КонецЦикла;
	Если Имена.Количество() > 0 Тогда
		Результат.Вставить(ИмяКоллекции, Имена);
	КонецЕсли;
КонецПроцедуры

Функция РежимРаботыИнформационнойБазы()
	Соединение = ВРег(СтрокаСоединенияИнформационнойБазы());
	Если СтрНачинаетсяС(Соединение, "FILE=") Тогда
		Возврат "file";
	КонецЕсли;
	Возврат "server";
