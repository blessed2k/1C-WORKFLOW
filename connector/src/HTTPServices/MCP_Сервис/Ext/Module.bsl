Функция УровеньЖурнала(Значение)
	// Go-клиент переводит уровень в русское название перед отправкой, но руками зовут и
	// английскими: принимаем оба, иначе отбор молча исчезает и приходят события всех уровней.
	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = ВРег(СокрЛП(Значение));
	Если Ключ = "ERROR" Или Ключ = "ОШИБКА" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Ключ = "WARNING" Или Ключ = "ПРЕДУПРЕЖДЕНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли Ключ = "INFORMATION" Или Ключ = "ИНФОРМАЦИЯ" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Ключ = "NOTE" Или Ключ = "ПРИМЕЧАНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ДобавитьОтборДаты(Отбор, Ключ, Значение)
	// Истина, если дата разобрана или не задана. Ложь означает мусор в параметре: молча
	// выбросить такой отбор нельзя, иначе клиент получит выборку шире запрошенной.
	Если ПустаяСтрока(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Отбор.Вставить(Ключ, XMLЗначение(Тип("Дата"), Значение));
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
КонецФункции

#КонецОбласти
