Функция ОтветОбъект(Запрос)

	// Go-клиент ходит на /object/{type}/{name}, ручные вызовы удобнее делать через
	// ?type=&name=: принимаем оба варианта.
	Тип = ПараметрЗапроса(Запрос, "type");
	Имя = ПараметрЗапроса(Запрос, "name");
	Если ПустаяСтрока(Тип) Или ПустаяСтрока(Имя) Тогда
		Возврат ОтветОшибки(Запрос, "Требуются параметры type и name", 400);
	КонецЕсли;

	РусскийТип = АнглийскийТипВРусский(Тип);
	Если РусскийТип = "" Тогда
		Возврат ОтветОшибки(Запрос, "Неизвестный тип объекта: " + Тип, 400);
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(РусскийТип + "." + Имя);
	Если ОбъектМД = Неопределено Тогда
		Возврат ОтветОшибки(Запрос, "Объект не найден: " + Тип + "." + Имя, 404);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("type", Тип);
	Результат.Вставить("name", ОбъектМД.Имя);
	Результат.Вставить("synonym", ПредставлениеСинонима(ОбъектМД));
	Результат.Вставить("attributes", РеквизитыВМассив(ОбъектМД, РусскийТип));
	// Имена ключей должны совпадать с тем, что читает Go-клиент (internal/source/httpsource.go):
	// именно tabularParts, а не tabularSections.
	Результат.Вставить("tabularParts", ТабличныеЧастиВМассив(ОбъектМД, РусскийТип));
	Результат.Вставить("dimensions", ПоляКоллекции(ОбъектМД, РусскийТип, "Измерения"));
	Результат.Вставить("resources", ПоляКоллекции(ОбъектМД, РусскийТип, "Ресурсы"));
	Результат.Вставить("values", ЗначенияПеречисленияВМассив(ОбъектМД, РусскийТип));
	Результат.Вставить("forms", ИменаКоллекции(ОбъектМД, РусскийТип, "Формы"));
	Результат.Вставить("commands", ИменаКоллекции(ОбъектМД, РусскийТип, "Команды"));

	Возврат ОтветJSON(Результат);

КонецФункции

Функция ОтветЗапрос(Запрос)

	Тело = ТелоЗапросаJSON(Запрос);
	Если Тело = Неопределено Тогда
		Возврат ОтветОшибки(Запрос, "Некорректный JSON в теле запроса", 400);
	КонецЕсли;

	ТекстЗапроса = "";
	Тело.Свойство("query", ТекстЗапроса);
	Если Не ЭтоSelect(ТекстЗапроса) Тогда
		Возврат ОтветОшибки(Запрос, "Разрешены только запросы ВЫБРАТЬ (SELECT)", 403);
	КонецЕсли;

	Лимит = ЛимитИзТела(Тело, 100, МаксимумСтрокЗапроса());

	ПараметрыТела = Неопределено;
	Тело.Свойство("parameters", ПараметрыТела);
	ТекстОшибки = "";
	Параметры = MCP_Запросы.ПараметрыЗапроса(ПараметрыТела, ТекстОшибки);
	Если Параметры = Неопределено Тогда
		Возврат ОтветОшибки(Запрос, ТекстОшибки, 400);
	КонецЕсли;

	СсылкиОбъектами = ФлагИзТела(Тело, "refs");
	Таймаут = ТаймаутИзТела(Тело);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Без ограничения времени запрос идёт как раньше, в этом же вызове. В монопольном режиме
	// фоновое задание не запустить, поэтому ограничение там не действует.
	Если Таймаут = 0 Или МонопольныйРежим() Тогда
		Попытка
			Результат = MCP_Запросы.РезультатЗапроса(ТекстЗапроса, Параметры, Лимит, СсылкиОбъектами);
		Исключение
			Возврат ОтветОшибки(Запрос, "Ошибка выполнения запроса: " + ИнформацияОбОшибке().Описание, 400, "query_failed");
		КонецПопытки;
	Иначе
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(ТекстЗапроса);
		ПараметрыЗадания.Добавить(Параметры);
		ПараметрыЗадания.Добавить(Лимит);
		ПараметрыЗадания.Добавить(СсылкиОбъектами);
		Итог = РезультатВФоне("MCP_Запросы.ВыполнитьВФоне", ПараметрыЗадания, Таймаут, "MCP: запрос к базе");
		Если Итог.Прерван Тогда
			Возврат ОтветОшибки(Запрос, СтрШаблон(
				"Запрос выполнялся дольше %1 с и прерван. Сузьте отбор: период, конкретная ссылка. "
				+ "Не обращайтесь через точку к полям составного типа (Регистратор, Объект, Субконто).",
				Формат(Таймаут, "ЧГ=")), 408, "query_timeout");
		КонецЕсли;
		Если Итог.ТекстОшибки <> "" Тогда
			Возврат ОтветОшибки(Запрос, "Ошибка выполнения запроса: " + Итог.ТекстОшибки, 400, "query_failed");
		КонецЕсли;
		Результат = Итог.Результат;
	КонецЕсли;

	Результат.Вставить("duration_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	Возврат ОтветJSON(Результат);

КонецФункции

Функция ОтветВалидацияЗапроса(Запрос)

	Тело = ТелоЗапросаJSON(Запрос);
	Если Тело = Неопределено Тогда
		Возврат ОтветОшибки(Запрос, "Некорректный JSON в теле запроса", 400);
	КонецЕсли;

	ТекстЗапроса = "";
	Тело.Свойство("query", ТекстЗапроса);

	Ошибки = Новый Массив;
	Валиден = Ложь;
	Попытка
		Запрос1С = Новый Запрос(ТекстЗапроса);
		Запрос1С.НайтиПараметры();
		Валиден = Истина;
	Исключение
		Ошибки.Добавить(ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Возврат ОтветJSON(Новый Структура("valid, errors", Валиден, Ошибки));

КонецФункции

Функция ОтветЖурнал(Запрос)

	Тело = ТелоЗапросаJSON(Запрос);
	Если Тело = Неопределено Тогда
		Возврат ОтветОшибки(Запрос, "Некорректный JSON в теле запроса", 400);
	КонецЕсли;

	// Отборы, порядок и состав полей разбирает MCP_Журнал: он же выполняется в фоновом задании.
	Таймаут = ТаймаутИзТела(Тело);
	Если Таймаут = 0 Или МонопольныйРежим() Тогда
		Результат = MCP_Журнал.РезультатЖурнала(Тело);
	Иначе
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(Тело);
		Итог = РезультатВФоне("MCP_Журнал.ПрочитатьВФоне", ПараметрыЗадания, Таймаут, "MCP: чтение журнала регистрации");
		Если Итог.Прерван Тогда
			Возврат ОтветОшибки(Запрос, СтрШаблон(
				"Журнал регистрации читался дольше %1 с, чтение прервано. Сузьте окно по дате или добавьте отбор.",
				Формат(Таймаут, "ЧГ=")), 408, "eventlog_timeout");
		КонецЕсли;
		Если Итог.ТекстОшибки <> "" Тогда
			Возврат ОтветОшибки(Запрос, "Ошибка чтения журнала регистрации: " + Итог.ТекстОшибки, 500, "eventlog_failed");
		КонецЕсли;
		Результат = Итог.Результат;
	КонецЕсли;

	Если Результат.Свойство("Ошибка") Тогда
		Возврат ОтветОшибки(Запрос, Результат.Ошибка.Текст, Результат.Ошибка.Статус, Результат.Ошибка.Код);
	КонецЕсли;
	Возврат ОтветJSON(Результат);

КонецФункции

Функция ОтветПодсистема(Запрос)

	Имя = ПараметрЗапроса(Запрос, "name");
	Если ПустаяСтрока(Имя) Тогда
		Возврат ОтветОшибки(Запрос, "Требуется имя подсистемы", 400);
	КонецЕсли;

	ОбъектМД = НайтиПодсистему(Метаданные.Подсистемы, Имя);
	Если ОбъектМД = Неопределено Тогда
		Возврат ОтветОшибки(Запрос, "Подсистема не найдена: " + Имя, 404);
	КонецЕсли;

	Дочерние = Новый Массив;
	Для Каждого Дочерняя Из ОбъектМД.Подсистемы Цикл
		Дочерние.Добавить(Дочерняя.Имя);
	КонецЦикла;

	Состав = Новый Массив;
	Для Каждого ЭлементСостава Из ОбъектМД.Состав Цикл
		Состав.Добавить(ЭлементСостава.ПолноеИмя());
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("name", ОбъектМД.Имя);
	Результат.Вставить("synonym", ПредставлениеСинонима(ОбъектМД));
	Результат.Вставить("subsystems", Дочерние);
	Результат.Вставить("content", Состав);

	Возврат ОтветJSON(Результат);

КонецФункции

Функция ОтветПредопределенные(Запрос)

	Тип = ПараметрЗапроса(Запрос, "type");
	Имя = ПараметрЗапроса(Запрос, "name");
	Если ПустаяСтрока(Тип) Или ПустаяСтрока(Имя) Тогда
		Возврат ОтветОшибки(Запрос, "Требуются параметры type и name", 400);
	КонецЕсли;

	РусскийТип = АнглийскийТипВРусский(Тип);
	Если РусскийТип = "" Тогда
		Возврат ОтветОшибки(Запрос, "Неизвестный тип объекта: " + Тип, 400);
	КонецЕсли;

	ОбъектМД = Метаданные.НайтиПоПолномуИмени(РусскийТип + "." + Имя);
	Если ОбъектМД = Неопределено Тогда
		Возврат ОтветОшибки(Запрос, "Объект не найден: " + Тип + "." + Имя, 404);
	КонецЕсли;

	Если Не ЕстьКоллекция(РусскийТип, "ПредопределенныеДанные") Тогда
		Возврат ОтветОшибки(Запрос, "У объекта нет предопределённых данных: " + Тип + "." + Имя, 400);
	КонецЕсли;

	// Список предопределённых читается запросом, а не из метаданных: коллекции
	// предопределённых у объекта метаданных в рантайме нет. Значит в ответ попадают
	// элементы, реально существующие в базе. Описанные в конфигурации, но не созданные,
	// сюда не войдут: это видно только в оффлайн-режиме по Ext/Predefined.xml.
	Лимит = МаксимумПредопределенных();
	Запрос1С = Новый Запрос;
	Запрос1С.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + "
		|	Таблица.Ссылка КАК Ссылка,
		|	Таблица.ИмяПредопределенныхДанных КАК Имя
		|ИЗ
		|	" + РусскийТип + "." + Имя + " КАК Таблица
		|ГДЕ
		|	Таблица.Предопределенный
		|УПОРЯДОЧИТЬ ПО
		|	Имя";

	Попытка
		Выборка = Запрос1С.Выполнить().Выбрать();
	Исключение
		Возврат ОтветОшибки(Запрос, "Ошибка чтения предопределённых: " + ИнформацияОбОшибке().Описание, 400, "read_failed");
	КонецПопытки;

	// Лишняя (Лимит + 1) строка означает, что список обрезан, и клиент это увидит.
	Элементы = Новый Массив;
	Обрезано = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() >= Лимит Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("name, ref", Выборка.Имя, Строка(Выборка.Ссылка)));
	КонецЦикла;

	Возврат ОтветJSON(Новый Структура("items, total, truncated",
		Элементы, Элементы.Количество(), Обрезано));

КонецФункции

#КонецОбласти

Функция ОтветJSON(Значение, Код = 200)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.УстановитьТелоИзСтроки(ВСтрокуJSON(Значение), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибки(Запрос, Текст, Код, Знач КодОшибки = "")
	// Веб-сервер перед 1С (IIS) подменяет тело ответа с кодом 4xx и 5xx своей страницей, и текст
	// ошибки до клиента не доходит. Клиент, который читает конверт, просит его заголовком: тогда
	// ошибка уходит с кодом 200 и телом {"error": {...}}. Остальным клиентам ответ прежний.
	Если НРег(ЗаголовокЗапроса(Запрос, "X-MCP-Errors")) = "envelope" Тогда
		Если КодОшибки = "" Тогда
			КодОшибки = КодОшибкиПоСтатусу(Код);
		КонецЕсли;
		Ошибка = Новый Структура("status, code, message", Код, КодОшибки, Текст);
		Возврат ОтветJSON(Новый Структура("error", Ошибка));
	КонецЕсли;
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция КодОшибкиПоСтатусу(Код)
	Если Код = 403 Тогда
		Возврат "forbidden";
	ИначеЕсли Код = 404 Тогда
		Возврат "not_found";
	Иначе
		Возврат "bad_request";
	КонецЕсли;
КонецФункции

Функция ОтветНаИсключение(Запрос, Ошибка)
	// Подробности со стеком остаются в журнале регистрации базы, клиенту уходит краткий текст.
	ЗаписьЖурналаРегистрации("MCPКоннектор.Ошибка обработки запроса",
		УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(Ошибка));
	Возврат ОтветОшибки(Запрос, КраткоеПредставлениеОшибки(Ошибка), 500, "internal_error");
КонецФункции

Функция ЗаголовокЗапроса(Запрос, Имя)
	// Имена заголовков HTTP нечувствительны к регистру, а соответствие заголовков чувствительно.
	ИскомоеИмя = НРег(Имя);
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = ИскомоеИмя Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ВСтрокуJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ТелоЗапросаJSON(Запрос)
	Попытка
		Строка = Запрос.ПолучитьТелоКакСтроку();
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Строка);
		Возврат ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ЭтоSelect(Текст)
	// Проверяем границу ключевого слова, иначе «ВЫБРАТЬЧТОУГОДНО» пройдёт как SELECT.
	Очищенный = ВРег(СокрЛП(УдалитьВедущиеКомментарии(Текст)));
	Возврат НачинаетсяСлово(Очищенный, "ВЫБРАТЬ") Или НачинаетсяСлово(Очищенный, "SELECT");
КонецФункции

Функция НачинаетсяСлово(Текст, Слово)
	Если Не СтрНачинаетсяС(Текст, Слово) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(Текст) = СтрДлина(Слово) Тогда
		Возврат Истина;
	КонецЕсли;
	Следующий = Сред(Текст, СтрДлина(Слово) + 1, 1);
	Возврат Следующий = " " Или Следующий = Символы.Таб Или Следующий = Символы.ПС
		Или Следующий = Символы.ВК;
КонецФункции

Функция УдалитьВедущиеКомментарии(Текст)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Результат = Новый Массив;
	Пропускаем = Истина;
	Для Каждого Строка Из Строки Цикл
		Если Пропускаем Тогда
			Обрезанная = СокрЛП(Строка);
			Если Обрезанная = "" Или СтрНачинаетсяС(Обрезанная, "//") Тогда
				Продолжить;
			КонецЕсли;
			Пропускаем = Ложь;
		КонецЕсли;
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Процедура ДобавитьКоллекциюМетаданных(Результат, ИмяКоллекции, Коллекция)
	Имена = Новый Массив;
	Для Каждого ОбъектМД Из Коллекция Цикл
		Имена.Добавить(ОбъектМД.Имя);
	КонецЦикла;
	Если Имена.Количество() > 0 Тогда
		Результат.Вставить(ИмяКоллекции, Имена);
	КонецЕсли;
КонецПроцедуры

Функция ВерсияКоннектора()
	// Совпадает с версией расширения в Configuration.xml: сверку делает connector/tools/build_src.py.
	Возврат "0.3.0.0";
КонецФункции

Функция ВозможностиКоннектора()
	// По этому списку клиент узнаёт, что умеет коннектор конкретной базы: версии в базах расходятся.
	Возможности = Новый Массив;
	Возможности.Добавить("error_envelope");
	Возможности.Добавить("query_timeout");
	Возможности.Добавить("query_typed_parameters");
	Возможности.Добавить("query_refs");
	Возможности.Добавить("eventlog_filters");
	Возможности.Добавить("eventlog_timeout");
	Возврат Возможности;
КонецФункции

Функция РасширенияБазы()
	Результат = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Описание = Новый Структура;
		Описание.Вставить("name", Расширение.Имя);
		Описание.Вставить("synonym", Расширение.Синоним);
		Описание.Вставить("version", Расширение.Версия);
		Описание.Вставить("active", Расширение.Активно);
		// Булево либо имя профиля безопасности.
		Описание.Вставить("safe_mode", Расширение.БезопасныйРежим);
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция РежимРаботыИнформационнойБазы()
	Соединение = ВРег(СтрокаСоединенияИнформационнойБазы());
	Если СтрНачинаетсяС(Соединение, "FILE=") Тогда
		Возврат "file";
	КонецЕсли;
	Возврат "server";
КонецФункции

Функция РезультатВФоне(ИмяМетода, ПараметрыМетода, Таймаут, Наименование)

	// Запрос и чтение журнала нельзя прервать изнутри вызова, который их выполняет, поэтому они
	// уходят в фоновое задание: сервис ждёт его не дольше таймаута и отменяет, если оно ещё активно.
	// Последним параметром метод получает адрес временного хранилища для результата.
	Итог = Новый Структура("Результат, ТекстОшибки, Прерван", Неопределено, "", Ложь);

	Адрес = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	ПараметрыМетода.Добавить(Адрес);

	Задание = ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыМетода, , Наименование);
	Задание = Задание.ОжидатьЗавершенияВыполнения(Таймаут);

	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Задание.Отменить();
		Итог.Прерван = Истина;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Итог.Результат = ПолучитьИзВременногоХранилища(Адрес);
	ИначеЕсли Задание.ИнформацияОбОшибке <> Неопределено Тогда
		Итог.ТекстОшибки = КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	Иначе
		Итог.ТекстОшибки = "фоновое задание отменено";
	КонецЕсли;

	УдалитьИзВременногоХранилища(Адрес);
	Возврат Итог;

КонецФункции

Функция ТаймаутИзТела(Тело)
	// 0 означает «без ограничения»: так ведёт себя и клиент, который таймаут не прислал.
	Значение = Неопределено;
	Если Не Тело.Свойство("timeout", Значение) Или ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Мин(Цел(Значение), МаксимумТаймаутаЗапроса());
КонецФункции

Функция ФлагИзТела(Тело, Ключ)
	Значение = Неопределено;
	Возврат Тело.Свойство(Ключ, Значение) И Значение = Истина;
КонецФункции

Функция МаксимумТаймаутаЗапроса()
	// Меньше таймаута HTTP-клиента (300 с): об обрыве должен сообщить коннектор, а не тишина.
	Возврат 240;
КонецФункции

Функция МаксимумСтрокЗапроса()
	Возврат 1000;
КонецФункции

Функция МаксимумПредопределенных()
	Возврат 1000;
КонецФункции

Функция ЛимитИзТела(Тело, ПоУмолчанию, Максимум)
	Лимит = ПоУмолчанию;
	Значение = Неопределено;
	Если Тело.Свойство("limit", Значение) И ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Лимит = Значение;
	КонецЕсли;
	Если Лимит > Максимум Тогда
		Лимит = Максимум;
	КонецЕсли;
	Возврат Лимит;
КонецФункции

Функция НайтиПодсистему(Коллекция, Имя)
	Для Каждого Подсистема Из Коллекция Цикл
		Если Подсистема.Имя = Имя Тогда
			Возврат Подсистема;
		КонецЕсли;
		Вложенная = НайтиПодсистему(Подсистема.Подсистемы, Имя);
		Если Вложенная <> Неопределено Тогда
			Возврат Вложенная;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПараметрЗапроса(Запрос, ИмяПараметра)
	Значение = Запрос.ПараметрыURL.Получить(ИмяПараметра);
	Если Значение = Неопределено Тогда
		Значение = Запрос.ПараметрыЗапроса.Получить(ИмяПараметра);
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция ЕстьКоллекция(ВидОбъекта, ИмяКоллекции)
	// У объектов метаданных нет метода Свойство(): состав коллекций определяется видом объекта.
	СПредопределенными = "Справочник,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета";
	СРеквизитами = "Справочник,Документ,РегистрСведений,РегистрНакопления,РегистрБухгалтерии,"
		+ "РегистрРасчета,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,ПланОбмена,"
		+ "БизнесПроцесс,Задача,Отчет,Обработка";
	СТабличнымиЧастями = "Справочник,Документ,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,"
		+ "ПланОбмена,БизнесПроцесс,Задача,Отчет,Обработка";
	СФормами = СРеквизитами + ",Перечисление,ЖурналДокументов";

	Владельцы = Новый Соответствие;
	Владельцы.Вставить("Реквизиты", СРеквизитами);
	Владельцы.Вставить("ТабличныеЧасти", СТабличнымиЧастями);
	Владельцы.Вставить("Измерения", "РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета");
	Владельцы.Вставить("Ресурсы", "РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета");
	Владельцы.Вставить("ЗначенияПеречисления", "Перечисление");
	Владельцы.Вставить("ПредопределенныеДанные", СПредопределенными);
	Владельцы.Вставить("Формы", СФормами);
	Владельцы.Вставить("Команды", СФормами);

	Виды = Владельцы.Получить(ИмяКоллекции);
	Если Виды = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрРазделить(Виды, ",", Ложь).Найти(ВидОбъекта) <> Неопределено;
КонецФункции

Функция ПолеВСтруктуру(Поле)
	Возврат Новый Структура("name, synonym, type",
		Поле.Имя, ПредставлениеСинонима(Поле), ТипыВМассив(Поле.Тип));
КонецФункции

Функция РеквизитыВМассив(ОбъектМД, ВидОбъекта)
	Возврат ПоляКоллекции(ОбъектМД, ВидОбъекта, "Реквизиты");
КонецФункции

Функция ПоляКоллекции(ОбъектМД, ВидОбъекта, ИмяКоллекции)
	Результат = Новый Массив;
	Если Не ЕстьКоллекция(ВидОбъекта, ИмяКоллекции) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Поле Из КоллекцияОбъекта(ОбъектМД, ИмяКоллекции) Цикл
		Результат.Добавить(ПолеВСтруктуру(Поле));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗначенияПеречисленияВМассив(ОбъектМД, ВидОбъекта)
	Результат = Новый Массив;
	Если Не ЕстьКоллекция(ВидОбъекта, "ЗначенияПеречисления") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Значение Из ОбъектМД.ЗначенияПеречисления Цикл
		Результат.Добавить(Новый Структура("name, synonym",
			Значение.Имя, ПредставлениеСинонима(Значение)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КоллекцияОбъекта(ОбъектМД, ИмяКоллекции)
	Если ИмяКоллекции = "Реквизиты" Тогда
		Возврат ОбъектМД.Реквизиты;
	ИначеЕсли ИмяКоллекции = "Измерения" Тогда
		Возврат ОбъектМД.Измерения;
	ИначеЕсли ИмяКоллекции = "Ресурсы" Тогда
		Возврат ОбъектМД.Ресурсы;
	ИначеЕсли ИмяКоллекции = "ТабличныеЧасти" Тогда
		Возврат ОбъектМД.ТабличныеЧасти;
	ИначеЕсли ИмяКоллекции = "Формы" Тогда
		Возврат ОбъектМД.Формы;
	ИначеЕсли ИмяКоллекции = "Команды" Тогда
		Возврат ОбъектМД.Команды;
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
КонецФункции

Функция ТабличныеЧастиВМассив(ОбъектМД, ВидОбъекта)
	Результат = Новый Массив;
	Если Не ЕстьКоллекция(ВидОбъекта, "ТабличныеЧасти") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ТЧ Из ОбъектМД.ТабличныеЧасти Цикл
		Реквизиты = Новый Массив;
		Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
			Реквизиты.Добавить(ПолеВСтруктуру(Реквизит));
		КонецЦикла;
		Результат.Добавить(Новый Структура("name, attributes", ТЧ.Имя, Реквизиты));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ИменаКоллекции(ОбъектМД, ВидОбъекта, ИмяКоллекции)
	Результат = Новый Массив;
	Если Не ЕстьКоллекция(ВидОбъекта, ИмяКоллекции) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из КоллекцияОбъекта(ОбъектМД, ИмяКоллекции) Цикл
		Результат.Добавить(Элемент.Имя);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТипыВМассив(ОписаниеТипов)
	Результат = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если МетаданныеТипа <> Неопределено Тогда
			Результат.Добавить(МетаданныеТипа.ПолноеИмя());
		Иначе
			Результат.Добавить(Строка(Тип));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПредставлениеСинонима(ОбъектМД)
	Если ОбъектМД.Синоним = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(ОбъектМД.Синоним);
КонецФункции

