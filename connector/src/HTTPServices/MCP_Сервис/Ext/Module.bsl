// Модуль HTTP-сервиса коннектора «1C-WORKFLOW».
// Строго read-only: только чтение метаданных, SELECT-запросы и журнал регистрации.
// НЕТ эндпоинтов записи и НЕТ выполнения произвольного кода (Выполнить/Вычислить).
//
// Контракт совпадает с Go-клиентом HTTPSource (internal/source/httpsource.go):
//   GET  /configuration                      -> ConfigurationInfo
//   GET  /metadata                           -> MetadataTree (плоская карта коллекций)
//   GET  /object/{type}/{name}               -> ObjectStructure
//   POST /query {query, parameters, limit, timeout, refs} -> QueryResult (только ВЫБРАТЬ, до 1000 строк)
//   POST /validate-query {query}             -> ValidateResult
//   POST /eventlog {start_date, end_date, level, user, limit, ...} -> EventLogResult (до 500 записей;
//        отборы, порядок и смещение: общий модуль MCP_Журнал)
//   GET  /subsystem/{name}                   -> SubsystemInfo
//   GET  /predefined/{type}/{name}           -> PredefinedList (до 1000 элементов)
//
// Ошибки. По умолчанию ошибка уходит кодом HTTP и текстом в теле. Клиенту, приславшему заголовок
// X-MCP-Errors: envelope, она уходит с кодом 200 и телом {"error": {"status", "code", "message"}}:
// веб-сервер перед 1С подменяет тело ответа 4xx и 5xx своей страницей. Go-клиент читает конверт
// в HTTPSource.do (тип ConnectorError).
//
// FormStructure и SearchCode в live не поддержаны: дерево элементов формы и тексты модулей
// во время исполнения недоступны, Go-клиент отдаёт по ним ошибку сам, эндпоинтов нет.

#Область ПрограммныйИнтерфейс

// Обработчики методов HTTP-сервиса. Каждый зовёт свою функцию ответа и превращает непредвиденное
// исключение в ответ с текстом ошибки: иначе веб-сервер отдаёт клиенту свою страницу 500 без причины.

Функция КонфигурацияGET(Запрос) Экспорт
	Попытка
		Возврат ОтветКонфигурация(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция МетаданныеGET(Запрос) Экспорт
	Попытка
		Возврат ОтветМетаданные(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ОбъектGET(Запрос) Экспорт
	Попытка
		Возврат ОтветОбъект(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ЗапросPOST(Запрос) Экспорт
	Попытка
		Возврат ОтветЗапрос(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ВалидацияЗапросаPOST(Запрос) Экспорт
	Попытка
		Возврат ОтветВалидацияЗапроса(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ЖурналPOST(Запрос) Экспорт
	Попытка
		Возврат ОтветЖурнал(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПодсистемаGET(Запрос) Экспорт
	Попытка
		Возврат ОтветПодсистема(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПредопределенныеGET(Запрос) Экспорт
	Попытка
		Возврат ОтветПредопределенные(Запрос);
	Исключение
		Возврат ОтветНаИсключение(Запрос, ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОтветыМетодов

Функция ОтветКонфигурация(Запрос)

	Результат = Новый Структура;
	Результат.Вставить("name", Метаданные.Имя);
	Результат.Вставить("synonym", ПредставлениеСинонима(Метаданные));
	Результат.Вставить("version", Метаданные.Версия);
	Результат.Вставить("vendor", Метаданные.Поставщик);
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	Результат.Вставить("platform_version", ИнформацияОСистеме.ВерсияПриложения);
	Результат.Вставить("mode", РежимРаботыИнформационнойБазы());
	Результат.Вставить("connector", Новый Структура("version, features", ВерсияКоннектора(), ВозможностиКоннектора()));
	// Список расширений платформа отдаёт не каждому пользователю. Отказ не должен ронять весь
	// ответ, поэтому его причина уходит клиенту отдельным полем.
	Попытка
		Результат.Вставить("extensions", РасширенияБазы());
	Исключение
		Результат.Вставить("extensions_error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ОтветJSON(Результат);

КонецФункции

