// Правильный вариант: &Перед (до подключения команд) + свой префикс + один вызов
&Перед("ПриСозданииНаСервере")
Процедура расшВ_ПриСозданииНаСервереПеред(Отказ, СтандартнаяОбработка)

	расшВ_ДобавитьСвоё();

КонецПроцедуры

&НаСервере
Процедура расшВ_ДобавитьСвоё()

	ДР = Новый Массив;
	ДР.Добавить(Новый РеквизитФормы(
		"расшВ_Признак", Новый ОписаниеТипов("Булево")));
	ИзменитьРеквизиты(ДР);

	// сравнение, а не присваивание - не должно считаться изменением формы
	Если Элементы.ГруппаШапка.Родитель = Элементы.ГруппаОсновная Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры
