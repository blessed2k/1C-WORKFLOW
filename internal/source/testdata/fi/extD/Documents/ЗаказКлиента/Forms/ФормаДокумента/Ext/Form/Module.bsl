&Вместо("ПриСозданииНаСервере")
Процедура расшГ_ПриСозданииНаСервереВместо(Отказ, СтандартнаяОбработка)

	// Копия типового метода: ПродолжитьВызов НЕ вызывается, но подключение БСП
	// повторено здесь же, поэтому команды и печать продолжают работать.
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	УправлениеПечатью.ПриСозданииНаСервере(ЭтотОбъект);

	ЭлементДата = Элементы.Найти("Дата");
	Если ЭлементДата <> Неопределено Тогда
		ЭлементДата.Заголовок = "Дата заказа";
	КонецЕсли;

КонецПроцедуры
