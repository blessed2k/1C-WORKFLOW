&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Родитель ЭЛЕМЕНТА СПРАВОЧНИКА (иерархия данных), а не элемента формы:
	// программным изменением формы это не является.
	Объект.Родитель = Справочники.Сотрудники.ПустаяСсылка();

	// Динамически добавляемые команды печати: именно их сбрасывает
	// ИзменитьРеквизиты, вызванный после этого места.
	ГруппаБейджек = Элементы.Вставить("ГруппаБейджек", Тип("ГруппаФормы"), Элементы.ФормаПечать);

	Для Каждого ИИ Из Бейджики Цикл
		Команда = Команды.Добавить("ПечатьБейджиков");
		Команда.Действие = "Подключаемый_ПечатьБейджика";
		Кнопка = Элементы.Вставить("бей", Тип("КнопкаФормы"), ГруппаБейджек);
		Кнопка.ИмяКоманды = Команда.Имя;
	КонецЦикла;

КонецПроцедуры
