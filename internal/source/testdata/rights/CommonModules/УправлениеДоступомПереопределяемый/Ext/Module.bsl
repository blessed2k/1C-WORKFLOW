// Стиль БСП 3.1: описания профилей через конструктор.
Процедура ПриЗаполненииПоставляемыхПрофилейГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт

	ОписаниеПрофиля = УправлениеДоступомБСП.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Имя = "Кладовщик";
	ОписаниеПрофиля.Идентификатор = "a1b2c3d4-0000-0000-0000-000000000001";
	ОписаниеПрофиля.Наименование = НСтр("ru = 'Кладовщик склада'");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеСвоих");
	ОписаниеПрофиля.Роли.Добавить("РедактированиеТоваров");
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);

	ОписаниеПрофиля = УправлениеДоступомБСП.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Имя = "Аудитор";
	ОписаниеПрофиля.Наименование = НСтр("ru = 'Аудитор'");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеВсех");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеСвоих");
	ОписаниеПрофиля.Роли.Добавить("ПросмотрЖурналаРегистрации");
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);

КонецПроцедуры

